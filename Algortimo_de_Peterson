#include <stdio.h>
#include <pthread.h>
#include <stdbool.h>

// Variables compartidas
bool flag[2] = {false, false};
int turno = 0;
int recurso_compartido = 0; // Recurso a proteger

void* proceso(void* arg) {
    int id = *((int*)arg);
    int otro = 1 - id;

    // --- ENTRADA A SECCIÓN CRÍTICA ---
    flag[id] = true;         // Indica interés
    turno = otro;            // Cede el turno al otro
    
    // Espera activa (while) mientras el otro tenga interés y sea su turno
    while (flag[otro] && turno == otro);

    // --- SECCIÓN CRÍTICA ---
    printf("Proceso %d entrando. Recurso: %d\n", id, ++recurso_compartido);
    
    // --- SALIDA DE SECCIÓN CRÍTICA ---
    flag[id] = false;        // Sale de la sección
    printf("Proceso %d saliendo.\n", id);

    return NULL;
}

int main() {
    pthread_t p1, p2;
    int id1 = 0, id2 = 1;

    pthread_create(&p1, NULL, proceso, &id1);
    pthread_create(&p2, NULL, proceso, &id2);

    pthread_join(p1, NULL);
    pthread_join(p2, NULL);

    return 0;
}
