#include <stdio.h>
#include <unistd.h>
#include <pthread.h>

int fd[2]; // fd[0] = lectura, fd[1] = escritura

void* productor(void* arg) {
    for (int i = 0; i < 10; i++) {
        write(fd[1], &i, sizeof(int)); // Envía mensaje
        printf("Produje: %d\n", i);
    }
    return NULL;
}

void* consumidor(void* arg) {
    int item;
    for (int i = 0; i < 10; i++) {
        read(fd[0], &item, sizeof(int)); // Recibe mensaje
        printf("Consumí: %d\n", item);
    }
    return NULL;
}

int main() {
    pthread_t prod, cons;
    pipe(fd); // Crear pipe

    pthread_create(&prod, NULL, productor, NULL);
    pthread_create(&cons, NULL, consumidor, NULL);

    pthread_join(prod, NULL);
    pthread_join(cons, NULL);

    return 0;
}
