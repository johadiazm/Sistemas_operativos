#include <stdio.h>
#include <pthread.h>
#include <stdbool.h>
#include <unistd.h>

// Variables compartidas
bool flag[2] = {false, false};
int turno = 0;
int recurso_compartido = 0; // Recurso a proteger

void* proceso(void* arg) {
    int id = *((int*)arg);
    int otro = 1 - id;

    for (int i = 0; i < 3; i++) {
        // --- Sección de Entrada (Protocolo de Dekker) ---
        flag[id] = true;
        while (flag[otro]) {
            if (turno == otro) {
                flag[id] = false;
                while (turno == otro) {
                    // Espera activa (espera a que sea su turno)
                }
                flag[id] = true;
            }
        }

        // --- Sección Crítica ---
        printf("Proceso %d entrando. Recurso: %d\n", id, ++recurso_compartido);
        sleep(1); // Simula trabajo
        printf("Proceso %d saliendo. Recurso: %d\n", id, recurso_compartido);

        // --- Sección de Salida ---
        turno = otro;
        flag[id] = false;

        // --- Sección Remanente ---
        sleep(1); 
    }
    return NULL;
}

int main() {
    pthread_t t1, t2;
    int id1 = 0, id2 = 1;

    pthread_create(&t1, NULL, proceso, &id1);
    pthread_create(&t2, NULL, proceso, &id2);

    pthread_join(t1, NULL);
    pthread_join(t2, NULL);

    return 0;
}
